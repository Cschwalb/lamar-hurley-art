# Copy this file to .env.local and fill in your own values.

# PayPal REST app client ID (https://developer.paypal.com/dashboard/applications).
# Use a SANDBOX client ID while testing. Leave as "test" to use PayPal's public demo sandbox.
VITE_PAYPAL_CLIENT_ID=test

# Currency for all prices and PayPal orders.
VITE_CURRENCY=USD

# Accounts with these emails (comma-separated) can use the /admin panel.
# Sign up on the site with one of them to become an admin.
ADMIN_EMAILS=you@example.com

# ---- Apple Pay (optional) ----
# Shows an Apple Pay button at checkout on Apple devices in Safari. Requires a real
# PayPal app with Apple Pay enabled, a verified domain and HTTPS. See README → Apple Pay.
VITE_ENABLE_APPLE_PAY=false

# Server-only settings (read by server/index.js, never sent to the browser).
# Your PayPal app secret. NEVER give this a VITE_ prefix.
PAYPAL_CLIENT_SECRET=
# sandbox or live
PAYPAL_ENV=sandbox
API_PORT=3001

# ---- Mass email (server only) ----
# Without these, emails are NOT sent: they're saved to server/data/outbox/ (preview mode).
# Use the SMTP settings from your email provider (Google Workspace, Outlook,
# SendGrid, Mailgun, Amazon SES, Postmark, Brevo...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "From" address, e.g.  LaMar Huley <studio@yourdomain.com>
MAIL_FROM=
# Public address of the site, used for unsubscribe links in emails.
SITE_URL=http://localhost:5173
